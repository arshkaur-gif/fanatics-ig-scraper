APIFY_API_TOKEN=your_apify_api_token_here
OPENAI_API_KEY=your_openai_api_key_here
# Required for /api/* — must match CLIENT_TAG in alveus/reach/app.js (401 if unset).
REACH_CLIENT_TAG=your_shared_client_tag_here
# Optional per-IP rate limit overrides (defaults: 20 calls / 600s).
REACH_RATE_LIMIT_MAX=
REACH_RATE_LIMIT_WINDOW_S=
# Optional: enable the Apify website content-crawler fallback for generic URLs.
# OFF by default. Pro-only — the crawl runs ~30s–2min, past Vercel Hobby's 10s cap.
ENABLE_CRAWLER_FALLBACK=
